{
  "schema_version": "0.2",
  "owner": "mike-axiom-mir",
  "selection": {
    "visibility": "public-only",
    "include_forks": false,
    "include_archived": false,
    "mode": "all-public-owner-repositories"
  },
  "excluded_repositories": [
    {
      "repository": "mike-axiom-mir/axm-collaboration-platform",
      "reason": "protected collaboration-platform protocol boundary; it may be called later through an explicit interface but must not be directly absorbed into the monolith"
    },
    {
      "repository": "mike-axiom-mir/axm-monolith",
      "reason": "assembler repository; recursive self-inclusion is forbidden"
    }
  ],
  "output": {
    "layout": "namespaced-modules",
    "strip_nested_git": true
  },
  "analysis": {
    "enabled": true,
    "mode": "deterministic-static-first",
    "auto_execute_discovered_tests": false,
    "generate_offline_dashboard": true
  },
  "build_enabled": true,
  "hold_reason": null,
  "finalization": {
    "automatic_plumbing": true,
    "package_requires_explicit_confirmation": true,
    "candidate_edges_count_as_execution": false,
    "declared_leaf_ids_count_as_execution": false,
    "required_workflows_must_have_accepted_receipts": true
  }
}
